  "narrative": {
    "northStar": "Индиго и стёжка (indigo-dyed linen with a running stitch)",
    "overview": "The system is a piece of indigo-dyed linen. A committed deep indigo shell (side rail, mobile header, active states) frames a cool pale linen-grey ground, and white surfaces sit on that ground without nesting. Ink-indigo text, a single accent family (indigo), and red reserved for values outside the laboratory range and for errors.\n\nThe one signature move is the running stitch: a dashed indigo thread. It is the spine of the client timeline, the underline beneath every section heading, the double-tone thread beneath the person header, the dashed edge of the attention list and empty states, the dashed ring on the active profile, and the dashed reference lines on indicator charts.\n\nDensity is calm and airy, phone first for clients and a desktop rail layout; staff get a dense three-pane workspace on the same tokens.",
    "keyCharacteristics": [
      "Indigo shell, linen ground, white flat surfaces, ink-indigo text.",
      "One accent family; red only for out-of-range values and errors.",
      "Onest for all text, drawn SVG icons in one 1.75 stroke.",
      "Running-stitch dashes as divider, spine, edge and chart reference.",
      "Soft two-layer shadows; the strong shadow is for popovers and the single assistant card.",
      "Motion limited to one entrance: the thread drawing itself, then cards rising in sequence."
    ],
    "rules": [
      {
        "name": "The Red Is a Finding Rule",
        "body": "Red appears only on a value outside the lab range (stated relative to the lab's reference) or on an error or destructive action. It is never decoration, never a brand color, never a tone for general emphasis.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "All emphasis is indigo in different depths (deep, dyed, thread, mist). No second accent hue.",
        "section": "colors"
      },
      {
        "name": "The Numerals Rule",
        "body": "Large single readings use proportional numerals with tight tracking; dense tables and entry rows (the A4 summary sheet, result-entry rows) use tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The One Face Rule",
        "body": "Onest only. No second display face, no monospace, no uppercase-tracked small labels.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Rest state is the card shadow at most. The pop shadow marks things that float or that are the one call to action of the screen. Hover on the assistant card lifts it 2px; no other card lifts.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Dyed Indigo (#2b3a7a) for the primary action and the Deep Indigo cloth (#1c2755) for shell surfaces; keep every emphasis inside the indigo family.",
      "Do mark every section with a title plus the stitch line, and carry sequences (events, steps) on the vertical stitch spine.",
      "Do reserve red (#b3362e on #fbecea) for values outside the lab range, phrased relative to the lab's reference, and for errors and destructive actions.",
      "Do keep surfaces flat and un-nested: white on linen, 1px hairline, card shadow.",
      "Do keep tap targets at 48px on phone and 44px on desktop, and body text at 16px or larger.",
      "Do use the 1.75-stroke drawn icon set at one weight, and the dashed 2px Thread Indigo outline for focus.",
      "Do keep motion to the entrance: thread draw, 40ms staggered rise; honor reduced motion."
    ],
    "donts": [
      "Don't add a second accent hue or a green medical skin; red is not a brand color.",
      "Don't build grids of identical bordered cards or nest a card inside a card.",
      "Don't use shadows beyond the card, pop and primary-button values, or lift cards on hover other than the assistant card.",
      "Don't use a second typeface, uppercase letter-spaced small labels, or glyph and emoji icons.",
      "Don't replace the stitch with a solid rule or a box border as a section divider."
    ]
  }
}