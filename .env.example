# Скопируйте в .env и заполните. Файл .env не коммитить.
# Живой помощник (чат, поручения, приветствие): выключен, включается CONCIERGE=1. Очередь документов для сотрудников работает всегда.
# CONCIERGE=1

# Вход сотрудников: пароль и код из письма. Отключить можно только явно: STAFF_2FA=0 (не делайте этого в production).
# STAFF_2FA=1

# В production без SMTP_HOST/SMTP_USER/SMTP_PASS сервер не запускается.
SMTP_HOST=
SMTP_PORT=587   # Brevo: если 587 закрыт сетью, используйте 2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Близкие <no-reply@your-domain.example>"
# Публичный адрес приложения: используется в ссылках из писем
APP_URL=http://localhost:5173
# production: Secure-cookie, строгий CSP, коды подтверждения не показываются на экране
NODE_ENV=development
# Распознавание бланков через Claude (см. README): ANTHROPIC_API_KEY=  AI_RECOGNITION=1
# Развёртывание: HOST=0.0.0.0 PORT=3000 DATA_DIR=/путь/к/постоянному/диску TRUST_PROXY=1 (за nginx, Caddy или облачным прокси)
# Администратор персонала при первом запуске: ADMIN_EMAIL=

# Резервные копии: раз в сутки в DATA_DIR/backups. BACKUP=0 отключает, BACKUP_DIR меняет папку, BACKUP_KEEP число копий (14).
