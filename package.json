{
  "name": "family-medcard",
  "version": "1.0.0",
  "description": "Близкие: личный помощник по здоровью семьи",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "dev": "vite",
    "build": "node scripts/copy-ocr.mjs && vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "backup": "node server/backup.js",
    "restore": "node scripts/restore.mjs",
    "share": "node scripts/share.mjs",
    "serve": "vite build && npm start",
    "share:public": "DATA_DIR=server/data/public node scripts/share.mjs",
    "metrics": "node scripts/metrics.mjs",
    "mail:test": "node --env-file-if-exists=.env scripts/mail-test.mjs",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "nodemailer": "^10.1.2",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.5"
  },
  "private": true
}
